# Mövcud .env faylını bu qovluğa köçürə bilərsən. Açarları paylaşma.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_VIDEO_MODEL=sora-2
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral

# ElevenLabs alternativ səs üçün:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Köhnə BLENDER_EXE adı da dəstəklənir. Yolu öz quraşdırmana uyğun yaz.
BLENDER_PATH=
BRIDGE_PORT=8765
ROBLOX_BRIDGE_PORT=8787
# SEARCH_ROOT=C:\Users\YourName\Documents
# ORION_APPS_JSON={"notepad":"C:\\Windows\\System32\\notepad.exe"}
# ORION_WAKE_WORD=Orion
# ORION_VOICE_THRESHOLD=0.012

# Yalnız seçilmiş model temperatur parametrini qəbul edirsə 1 et:
ORION_TEMPERATURE_SUPPORTED=0
# Roblox-a avtomatik FBX yükləmək üçün (məcburi deyil):
ROBLOX_API_KEY=
ROBLOX_CREATOR_ID=

# Optional: trusted HTTPS release manifest; see YENILEME_053_AZ.md
ORION_UPDATE_MANIFEST_URL=
ORION_UPDATE_TOKEN=
